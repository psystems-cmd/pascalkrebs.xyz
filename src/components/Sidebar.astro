---
import Logo from "./Logo.astro";

interface Props {
  active: "my-story" | "projects" | "work" | "reading-list" | "contact";
}

const { active } = Astro.props;

const navItems = [
  { label: "My Story", href: "/my-story", id: "my-story" },
  { label: "Projects", href: "/projects", id: "projects" },
  { label: "Work", href: "/work", id: "work" },
  { label: "Reading List", href: "/reading-list", id: "reading-list" },
  { label: "Contact", href: "/contact", id: "contact" },
] as const;
---

<aside class="shrink-0 w-full md:w-48 md:fixed md:top-0 md:left-0 md:h-screen md:pt-24 md:pl-16">
  <div class="flex items-center justify-between md:block px-5 py-4 md:p-0">
    <Logo />
    <button
      id="mobile-nav-toggle"
      class="md:hidden w-10 h-10 flex items-center justify-center"
      aria-label="Toggle navigation"
    >
      <svg id="menu-icon" width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line y1="1" x2="20" y2="1" stroke="#1a1a1a" stroke-width="1.5"/>
        <line y1="7" x2="20" y2="7" stroke="#1a1a1a" stroke-width="1.5"/>
        <line y1="13" x2="20" y2="13" stroke="#1a1a1a" stroke-width="1.5"/>
      </svg>
      <svg id="close-icon" class="hidden" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="1" y1="1" x2="15" y2="15" stroke="#1a1a1a" stroke-width="1.5"/>
        <line x1="15" y1="1" x2="1" y2="15" stroke="#1a1a1a" stroke-width="1.5"/>
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden md:block px-5 pb-5 md:px-0 md:pb-0 md:mt-10">
    <ul class="flex flex-col gap-2 md:gap-1 border-t border-grey-light pt-4 md:border-0 md:pt-0">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block py-1.5 text-base transition-colors",
              active === item.id ? "text-black font-bold" : "text-grey hover:text-black",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const nav = document.getElementById("mobile-nav");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  toggle?.addEventListener("click", () => {
    const isHidden = nav?.classList.toggle("hidden");
    menuIcon?.classList.toggle("hidden", !isHidden);
    closeIcon?.classList.toggle("hidden", isHidden);
  });
</script>
