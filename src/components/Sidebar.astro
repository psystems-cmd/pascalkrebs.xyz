---
import Logo from "./Logo.astro";

interface Props {
  active: "my-story" | "projects" | "work" | "contact";
}

const { active } = Astro.props;

const navItems = [
  { label: "My Story", href: "/my-story", id: "my-story" },
  { label: "Projects", href: "/projects", id: "projects" },
  { label: "Work", href: "/work", id: "work" },
  { label: "Contact", href: "/contact", id: "contact" },
] as const;
---

<aside class="shrink-0 w-full md:w-48 md:fixed md:top-0 md:left-0 md:h-screen md:pt-24 md:pl-16">
  <div class="flex items-center justify-between md:block p-6 md:p-0">
    <Logo />
    {/* Mobile menu toggle */}
    <button
      id="mobile-nav-toggle"
      class="md:hidden text-2xl"
      aria-label="Toggle navigation"
    >
      &#9776;
    </button>
  </div>
  <nav id="mobile-nav" class="hidden md:block px-6 pb-6 md:px-0 md:pb-0 md:mt-10">
    <ul class="flex flex-row gap-4 md:flex-col md:gap-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block py-1 text-base transition-colors",
              active === item.id ? "text-black font-bold" : "text-grey hover:text-black",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const nav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    nav?.classList.toggle("hidden");
  });
</script>
