---
import SidebarLayout from "../layouts/SidebarLayout.astro";

const books = [
  { title: "Atlas of AI", author: "Kate Crawford", note: "", url: "https://katecrawford.net/atlas" },
  { title: "The Almanack of Naval Ravikant", author: "Eric Jorgenson", note: "" },
  { title: "Greenlights", author: "Matthew McConaughey", note: "" },
  { title: "Technofeudalism", author: "Yanis Varoufakis", note: "" },
  { title: "HBR's 10 Must Reads on Building a Great Culture", author: "Harvard Business Review", note: "" },
];

const articles = [
  { title: "Mean Images", source: "Hito Steyerl · New Left Review 140/141", url: "https://newleftreview.org/issues/ii140/articles/hito-steyerl-mean-images", note: "" },
  { title: "EU Compute Forecast", source: "Europe 2031", url: "https://europe2031.ai/compute-forecast/", note: "" },
  { title: "AI 2027", source: "ai2027.org", url: "https://ai2027.org/", note: "" },
];

const papers = [
  { title: "Excavating AI", authors: "Kate Crawford & Trevor Paglen", url: "https://excavating.ai/", note: "" },
  { title: "Latent Spaces: AI Art and the Archive", authors: "Maud Ceuterick · October, MIT Press", url: "https://direct.mit.edu/octo/article/doi/10.1162/OCTO.a.545/137249/Latent-Spaces-AI-Art-and-the-Archive", note: "" },
];
---

<SidebarLayout title="Reading List — Pascal Krebs" active="reading-list">
  <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">Things I read and liked.</h1>
  <p class="text-grey mb-12">Books, articles, and papers that shaped how I think. Updated when something sticks.</p>

  <section class="mb-14">
    <h2 class="text-xl font-bold mb-6">Books</h2>
    <div class="space-y-4">
      {books.map((b) => (
        <div class="border-l-2 border-grey-light pl-5">
          {b.url ? (
            <a href={b.url} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4">{b.title}</a>
          ) : (
            <p class="font-bold">{b.title}</p>
          )}
          <p class="text-sm text-grey">{b.author}</p>
          {b.note && <p class="mt-1 text-sm">{b.note}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="mb-14">
    <h2 class="text-xl font-bold mb-6">Articles</h2>
    <div class="space-y-4">
      {articles.map((a) => (
        <div class="border-l-2 border-grey-light pl-5">
          <a href={a.url} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4">{a.title}</a>
          <p class="text-sm text-grey">{a.source}</p>
          {a.note && <p class="mt-1 text-sm">{a.note}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="mb-14">
    <h2 class="text-xl font-bold mb-6">Papers</h2>
    <div class="space-y-4">
      {papers.map((p) => (
        <div class="border-l-2 border-grey-light pl-5">
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4">{p.title}</a>
          <p class="text-sm text-grey">{p.authors}</p>
          {p.note && <p class="mt-1 text-sm">{p.note}</p>}
        </div>
      ))}
    </div>
  </section>
</SidebarLayout>
