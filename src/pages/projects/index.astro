---
import SidebarLayout from "../../layouts/SidebarLayout.astro";

const graveyard = [
  { name: "Bridety", slug: "bridety", year: "2021–2022", line: "An OS for bridal shops" },
  { name: "NAVVEL", slug: "navvel", year: "", line: "Knowledge base of academic frameworks" },
  { name: "Augmate", slug: "augmate", year: "2024", line: "Agent marketplace" },
  { name: "StoryStack", slug: "storystack", year: "2024–2025", line: "Source of truth for product × marketing × sales" },
  { name: "Huble Agency", slug: "huble-agency", year: "2020–2022", line: "Brand agency" },
];

const builds = [
  { name: "Impossible Founder", slug: "impossible-founder", year: "", line: "Startup Factory Hamburg — EXIST programme" },
  { name: "START Hamburg", slug: "start-hamburg", year: "2022–2023", line: "Student × startup ecosystem, zero to one" },
  { name: "BORINO Rebrand", slug: "borino", year: "", line: "Botanical aperitif — brand strategy" },
  { name: "Stadium POS", slug: "stadium-pos", year: "2018", line: "The first thing I ever built" },
  { name: "Firefighter Tech", slug: "firefighter", year: "", line: "Drone unit & incident command software" },
];

const research = [
  { name: "Branding × Startup Funding", slug: "branding-startup-funding", year: "", line: "Bachelor's thesis — 10,000 startups" },
  { name: "Airbus Portfolio Model", slug: "airbus-portfolio", year: "", line: "Client portfolio valuation" },
  { name: "Spikes / Neuroscience Brand Valuation", slug: "spikes", year: "", line: "Deloitte — Excitement Points" },
  { name: "Wempe Rebrand", slug: "wempe", year: "", line: "Identity via Carl Jung archetypes" },
];
---

<SidebarLayout title="Projects — Pascal Krebs" active="projects">
  <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-12">Stuff that I am (or was) building.</h1>

  <section class="mb-14">
    <h2 class="text-xl font-bold mb-2">The Graveyard</h2>
    <p class="text-grey text-sm mb-6">Startups I killed. Each one taught me something.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {graveyard.map((p) => (
        <a href={`/projects/${p.slug}`} class="block bg-grey-light rounded-xl p-5 hover:bg-black hover:text-white transition-colors group">
          <span class="font-bold block">{p.name}</span>
          <span class="text-sm text-grey group-hover:text-white/70 block mt-1">{p.line}</span>
          {p.year && <span class="text-xs text-grey group-hover:text-white/50 block mt-2">{p.year}</span>}
        </a>
      ))}
    </div>
  </section>

  <section class="mb-14">
    <h2 class="text-xl font-bold mb-2">Builds</h2>
    <p class="text-grey text-sm mb-6">Things that shipped, grew, or still exist.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {builds.map((p) => (
        <a href={`/projects/${p.slug}`} class="block bg-grey-light rounded-xl p-5 hover:bg-black hover:text-white transition-colors group">
          <span class="font-bold block">{p.name}</span>
          <span class="text-sm text-grey group-hover:text-white/70 block mt-1">{p.line}</span>
          {p.year && <span class="text-xs text-grey group-hover:text-white/50 block mt-2">{p.year}</span>}
        </a>
      ))}
    </div>
  </section>

  <section class="mb-14">
    <h2 class="text-xl font-bold mb-2">Research & Academic</h2>
    <p class="text-grey text-sm mb-6">Papers, models, and university projects.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {research.map((p) => (
        <a href={`/projects/${p.slug}`} class="block bg-grey-light rounded-xl p-5 hover:bg-black hover:text-white transition-colors group">
          <span class="font-bold block">{p.name}</span>
          <span class="text-sm text-grey group-hover:text-white/70 block mt-1">{p.line}</span>
          {p.year && <span class="text-xs text-grey group-hover:text-white/50 block mt-2">{p.year}</span>}
        </a>
      ))}
    </div>
  </section>
</SidebarLayout>
