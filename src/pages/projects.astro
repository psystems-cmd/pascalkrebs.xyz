---
import SidebarLayout from "../layouts/SidebarLayout.astro";

const categories = [
  {
    title: "Products",
    items: [
      { name: "Placeholder" },
      { name: "Placeholder" },
      { name: "Placeholder" },
    ],
  },
  {
    title: "Research",
    items: [
      { name: "Placeholder" },
      { name: "Placeholder" },
      { name: "Placeholder" },
    ],
  },
  {
    title: "Startups",
    items: [
      { name: "Placeholder" },
      { name: "Placeholder" },
      { name: "Placeholder" },
    ],
  },
];
---

<SidebarLayout title="Projects — Pascal Krebs" active="projects">
  <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-12">Stuff that I am (or was) building.</h1>

  {categories.map((cat) => (
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-4">{cat.title}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {cat.items.map(() => (
          <div class="bg-grey-light rounded-xl aspect-[4/3]" />
        ))}
      </div>
    </section>
  ))}
</SidebarLayout>
