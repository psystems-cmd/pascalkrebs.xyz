---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
---

<BaseLayout title="Pascal Krebs">
  <div class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <Logo size="lg" />
    <h1 class="mt-8 text-3xl md:text-4xl font-bold leading-tight max-w-2xl">
      I'm translating from humans to machines<br class="hidden md:inline" />
      and vice-versa.
    </h1>
    <a
      href="/my-story"
      class="mt-10 inline-block bg-black text-white px-8 py-4 rounded-lg hover:bg-black/80 transition-colors"
    >
      Get to know me a bit ...
    </a>
  </div>
</BaseLayout>
