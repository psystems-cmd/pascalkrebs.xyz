---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
---

<BaseLayout title="Pascal Krebs">
  <div id="splash" class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <div id="logo-wrap" class="transition-transform duration-1000 ease-in-out">
      <Logo size="lg" />
    </div>
    <h1 id="tagline" class="mt-14 text-2xl md:text-3xl font-bold leading-tight opacity-0 transition-opacity duration-1000 ease-in">
      <span class="whitespace-nowrap">I'm translating from humans to machines</span><br />
      and vice-versa.
    </h1>
    <a
      href="/my-story"
      id="enter-link"
      class="mt-10 text-sm text-grey underline underline-offset-4 hover:text-black transition-colors opacity-0 transition-opacity duration-1000 ease-in"
    >
      Get to know me a bit ...
    </a>
  </div>

  <script>
    const tagline = document.getElementById("tagline");
    const enterLink = document.getElementById("enter-link");
    const logoWrap = document.getElementById("logo-wrap");

    // Fade in tagline and link after a short delay
    setTimeout(() => {
      tagline?.classList.remove("opacity-0");
    }, 400);

    setTimeout(() => {
      enterLink?.classList.remove("opacity-0");
    }, 800);

    // After 5s: scale up logo, fade out everything, then navigate
    setTimeout(() => {
      logoWrap?.classList.add("scale-150");
      tagline?.classList.add("opacity-0");
      enterLink?.classList.add("opacity-0");

      setTimeout(() => {
        window.location.href = "/my-story";
      }, 1000);
    }, 5000);
  </script>
</BaseLayout>
