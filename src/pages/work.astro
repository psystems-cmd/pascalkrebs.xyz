---

<SidebarLayout title="Work — Pascal Krebs" active="work">
  <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">Companies I worked for, with, and on.</h1>
  <p class="text-grey mb-12">
    This is basically <a href="https://www.linkedin.com/in/pascal-finn-krebs/" target="_blank" rel="noopener noreferrer" class="text-black underline underline-offset-4">LinkedIn</a>, but without text-limitations and with a lot of context.
  </p>

  <section class="mb-16">
    <h2 class="text-xl font-bold mb-8">Experience</h2>
    <div class="space-y-10">
      {experience.map((e) => (
        <div class="border-l-2 border-grey-light pl-5">
          <p class="text-sm text-grey">{e.period} · {e.location}</p>
          <h3 class="font-bold mt-1">{e.company}</h3>
          <p class="text-sm text-grey mt-0.5">{e.role}</p>
          <p class="mt-2">{e.description}</p>
          {e.link && (
            <a href={e.link.href} class="text-sm underline underline-offset-4 mt-2 inline-block">{e.link.label}</a>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-xl font-bold mb-8">Early Career</h2>
    <div class="space-y-6">
      {earlyCareer.map((e) => (
        <div class="border-l-2 border-grey-light pl-5">
          <p class="text-sm text-grey">{e.period} · {e.location}</p>
          <h3 class="font-bold mt-1">{e.company}</h3>
          <p class="text-sm text-grey mt-0.5">{e.role}</p>
          <p class="mt-2">{e.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-xl font-bold mb-8">Education</h2>
    <div class="space-y-6">
      {education.map((e) => (
        <div class="border-l-2 border-grey-light pl-5">
          {e.period && <p class="text-sm text-grey">{e.period}</p>}
          <h3 class="font-bold mt-1">{e.school}</h3>
          <p class="text-sm text-grey mt-0.5">{e.degree}</p>
          {e.note && <p class="mt-2">{e.note}</p>}
        </div>
      ))}
    </div>
  </section>
</SidebarLayout>
